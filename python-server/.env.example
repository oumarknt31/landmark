# Copy to .env locally; on Render, set these via the dashboard.

# Supabase — service role key has full DB access; SERVER ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — used by the question generator only.
ANTHROPIC_API_KEY=

# Admin token guarding POST /generate. Pick a long random string.
ADMIN_TOKEN=

# Comma-separated list of allowed CORS origins.
# Dev: http://localhost:5173,http://localhost:4173
# Prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Port to bind (Render overrides via $PORT).
PORT=8000

# Absolute or relative path to the content directory shipped from the frontend.
# Used by the search router to index lessons + questions.
CONTENT_DIR=../src/content
