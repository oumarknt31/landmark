# Copy to .env locally; on Render, set these via the dashboard.

# Supabase — service role key has full DB access; SERVER ONLY, never exposed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Comma-separated list of allowed CORS origins.
# In dev: http://localhost:5173,http://localhost:4173
# In prod: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Port to bind (Render overrides this with its own value).
PORT=8080

# Rate limiting for /api/explain (tokens per IP).
EXPLAIN_RATE_CAPACITY=60
EXPLAIN_RATE_REFILL=60

# Python FastAPI service base URL (e.g., http://localhost:8000 in dev,
# https://landmark-python-server.onrender.com in prod). Reached only
# server-to-server; never exposed to the browser.
PYTHON_SERVICE_URL=http://localhost:8000
# Shared secret guarding the Python /analytics + /generate endpoints.
# Must match python-server/.env ADMIN_TOKEN.
PYTHON_ADMIN_TOKEN=
# Gateway-side admin token. Required to call /api/py/generate.
GATEWAY_ADMIN_TOKEN=
