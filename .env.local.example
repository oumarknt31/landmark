# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored (via *.local in .gitignore) so secrets stay off git.

# === Client-safe values ===
# These are bundled into the browser. They are designed to be public —
# Sentry's DSN identifies your project; Supabase's anon key is protected by
# Row-Level Security policies on the database.

VITE_SENTRY_DSN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# === Server-side only ===
# This key has full account access. NEVER expose it to the browser.
# It is only read inside the Vercel serverless function that proxies
# Anthropic API calls.

ANTHROPIC_API_KEY=
